<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <add name="FoodBridgeDB"
         connectionString="Provider=Microsoft.Jet.OLEDB.4.0;Data Source=|DataDirectory|\Food.mdb;"
         providerName="System.Data.OleDb" />
  </connectionStrings>

  <appSettings>
    <add key="ApplicationTitle" value="FoodBridge – Food Rescue and Donation Management System" />
    <add key="Slogan" value="Save Food. Share Hope. Feed Lives." />
    <add key="MaxUploadBytes" value="5242880" />
  </appSettings>

  <system.web>
    <compilation debug="true" strict="false" explicit="true" targetFramework="4.0" />
    <httpRuntime requestValidationMode="2.0" maxRequestLength="10240" executionTimeout="120" />
    <pages controlRenderingCompatibilityVersion="3.5" clientIDMode="AutoID" validateRequest="false" />
    <sessionState mode="InProc" timeout="30" cookieless="false" />
    <customErrors mode="Off" />
    <authentication mode="Forms">
      <forms loginUrl="~/Account/Login.aspx" timeout="30" defaultUrl="~/Default.aspx" />
    </authentication>
  </system.web>

  <system.webServer>
    <modules runAllManagedModulesForAllRequests="true" />
    <defaultDocument>
      <files>
        <clear />
        <add value="Default.aspx" />
      </files>
    </defaultDocument>
  </system.webServer>
</configuration>
