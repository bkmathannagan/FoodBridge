flowchart TB
    subgraph PL["Presentation Layer (ASP.NET Web Forms - .aspx / Site.Master)"]
        PUB["Public Pages (Default, About, HowItWorks, Contact)"]
        ACC["Account Module (Login, RegisterDonor/NGO/Volunteer, ForgotPassword)"]
        ADM["Admin Portal (Dashboard, ManageDonors/NGOs/Volunteers/Donations/Requests, Assign, Reports, Settings)"]
