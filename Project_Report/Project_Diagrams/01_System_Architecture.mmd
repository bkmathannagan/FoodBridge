        VOL["Volunteer Portal (Dashboard, MyTasks, UpdateDelivery, TaskDetails)"]
    end

    subgraph BLL["Business Logic Layer (VB.NET Classes - /BLL)"]
        DBLL["DonorBLL.vb"]
        NBLL["NGOBLL.vb"]
        VBLL["VolunteerBLL.vb"]
        FBLL["DonationBLL.vb"]
        RBLL["RequestBLL.vb"]
        ABLL["AssignmentBLL.vb"]
        RPBLL["ReportBLL.vb"]
    end

    subgraph DAL["Data Access Layer (VB.NET + OleDb - /DAL)"]
        DBC["DBConnection.vb (Parameterized OleDb + SHA-256 + Transactions)"]
        DDAL["DonorDAL.vb"]
        NDAL["NGODAL.vb"]
        VDAL["VolunteerDAL.vb"]
        FDAL["DonationDAL.vb"]
        RDAL["RequestDAL.vb"]
