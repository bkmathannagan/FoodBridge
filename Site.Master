<%@ Master Language="VB" AutoEventWireup="false" CodeBehind="Site.Master.vb" Inherits="FoodBridge.SiteMaster" %>
<!DOCTYPE html>
<html lang="en">
<head runat="server">
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>FoodBridge – Food Rescue and Donation Management System</title>
    <meta name="description" content="FoodBridge connects food donors, hotels, marriage halls, and supermarkets with verified NGOs and volunteers to rescue surplus food and feed people in need." />
    <meta name="keywords" content="Food Rescue System, Food Donation Management, Food Waste Reduction, Donate Surplus Food, NGO Food Donation, Food Collection, Food Distribution, Volunteer Food Rescue" />
    <meta name="author" content="FoodBridge Food Rescue Network" />
    <link rel="stylesheet" type="text/css" href="~/Content/css/site.css" runat="server" />
    <asp:ContentPlaceHolder ID="HeadContent" runat="server" />
</head>
<body>
    <form id="form1" runat="server" enctype="multipart/form-data">
        <!-- Top Announcement Bar -->
        <div class="top-bar no-print">
            <div class="container top-bar-inner">
                <div>
                    <strong>&#127793; Save Food. Share Hope. Feed Lives.</strong>
                    <span style="margin-left: 12px;">24x7 Food Rescue Helpline: +91 800-123-FOOD (3663)</span>
                </div>
                <div>
                    <asp:Literal ID="litTopBarUser" runat="server" />
                </div>
            </div>
        </div>

        <!-- Main Header Navigation -->
        <header class="site-header no-print">
            <div class="container navbar">
                <a href="<%= ResolveUrl("~/Default.aspx") %>" class="brand-logo">
                    <span class="logo-badge">FB</span>
                    <span>Food<span class="accent-text">Bridge</span></span>
                </a>

                <button type="button" class="mobile-menu-toggle" onclick="toggleMobileMenu()">&#9776; Menu</button>

                <ul id="mainNavLinks" class="nav-links">
                    <li><a href="<%= ResolveUrl("~/Default.aspx") %>">Home</a></li>
                    <li><a href="<%= ResolveUrl("~/About.aspx") %>">About Us</a></li>
                    <li><a href="<%= ResolveUrl("~/HowItWorks.aspx") %>">How It Works</a></li>
                    <li><a href="<%= ResolveUrl("~/Account/RegisterDonor.aspx") %>">Donate Food</a></li>
                    <li><a href="<%= ResolveUrl("~/NGO/AvailableFood.aspx") %>">Find Food</a></li>
                    <li><a href="<%= ResolveUrl("~/Account/RegisterVolunteer.aspx") %>">Become a Volunteer</a></li>
                    <li><a href="<%= ResolveUrl("~/Account/RegisterNGO.aspx") %>">NGO Registration</a></li>
                    <li><a href="<%= ResolveUrl("~/Contact.aspx") %>">Contact Us</a></li>
                </ul>

                <div class="nav-actions">
                    <asp:Panel ID="pnlGuestActions" runat="server">
                        <a href="<%= ResolveUrl("~/Account/Login.aspx") %>" class="btn btn-primary btn-sm">Login</a>
                    </asp:Panel>
                    <asp:Panel ID="pnlUserActions" runat="server" Visible="false">
                        <asp:HyperLink ID="hlMyDashboard" runat="server" CssClass="btn btn-primary btn-sm" Text="My Dashboard" />
                        <a href="<%= ResolveUrl("~/Account/Logout.aspx") %>" class="btn btn-danger btn-sm">Logout</a>
                    </asp:Panel>
                </div>
            </div>
        </header>

        <!-- Unified Layout Container (Public Full-Width OR Role Dashboard Sidebar) -->
        <div id="divLayoutWrapper" runat="server">
            <asp:Panel ID="pnlSidebar" runat="server" CssClass="dashboard-sidebar no-print" Visible="false">
                <div class="sidebar-role-badge">
                    <div class="role-label"><asp:Literal ID="litSidebarRole" runat="server" /></div>
                    <div class="user-name"><asp:Literal ID="litSidebarUser" runat="server" /></div>
                </div>

                <!-- Admin Menu -->
                <asp:Panel ID="pnlAdminMenu" runat="server" Visible="false">
                    <ul class="sidebar-menu">
                        <li><a href="<%= ResolveUrl("~/Admin/Dashboard.aspx") %>">&#128202; Dashboard</a></li>
                        <li><a href="<%= ResolveUrl("~/Admin/ManageDonations.aspx") %>">&#127858; Manage Donations</a></li>
                        <li><a href="<%= ResolveUrl("~/Admin/ManageRequests.aspx") %>">&#128203; Manage Food Requests</a></li>
                        <li><a href="<%= ResolveUrl("~/Admin/AssignVolunteers.aspx") %>">&#128666; Assign Volunteers</a></li>
                        <li><a href="<%= ResolveUrl("~/Admin/ManageDonors.aspx") %>">&#127970; Manage Donors</a></li>
                        <li><a href="<%= ResolveUrl("~/Admin/ManageNGOs.aspx") %>">&#129309; Manage NGOs</a></li>
                        <li><a href="<%= ResolveUrl("~/Admin/ManageVolunteers.aspx") %>">&#128100; Manage Volunteers</a></li>
                        <li><a href="<%= ResolveUrl("~/Admin/ManageCategories.aspx") %>">&#128194; Categories &amp; Cities</a></li>
                        <li><a href="<%= ResolveUrl("~/Admin/Reports.aspx") %>">&#128200; Reports &amp; Export</a></li>
                        <li><a href="<%= ResolveUrl("~/Admin/Settings.aspx") %>">&#9881; Feedback, Alerts &amp; Settings</a></li>
                        <li><a href="<%= ResolveUrl("~/Account/Logout.aspx") %>">&#128682; Logout</a></li>
                    </ul>
                </asp:Panel>

                <!-- Donor Menu -->
                <asp:Panel ID="pnlDonorMenu" runat="server" Visible="false">
                    <ul class="sidebar-menu">
                        <li><a href="<%= ResolveUrl("~/Donor/Dashboard.aspx") %>">&#128202; Donor Dashboard</a></li>
                        <li><a href="<%= ResolveUrl("~/Donor/AddDonation.aspx") %>">&#10133; Submit Food Donation</a></li>
                        <li><a href="<%= ResolveUrl("~/Donor/MyDonations.aspx") %>">&#127858; My Donations &amp; History</a></li>
                        <li><a href="<%= ResolveUrl("~/Donor/Profile.aspx") %>">&#128100; Profile &amp; Feedback</a></li>
                        <li><a href="<%= ResolveUrl("~/Account/Logout.aspx") %>">&#128682; Logout</a></li>
                    </ul>
                </asp:Panel>

                <!-- NGO Menu -->
                <asp:Panel ID="pnlNGOMenu" runat="server" Visible="false">
                    <ul class="sidebar-menu">
                        <li><a href="<%= ResolveUrl("~/NGO/Dashboard.aspx") %>">&#128202; NGO Dashboard</a></li>
                        <li><a href="<%= ResolveUrl("~/NGO/AvailableFood.aspx") %>">&#127858; Available Food Donations</a></li>
                        <li><a href="<%= ResolveUrl("~/NGO/FoodRequest.aspx") %>">&#128221; Submit Food Request</a></li>
                        <li><a href="<%= ResolveUrl("~/NGO/RequestHistory.aspx") %>">&#128203; Request &amp; Receipt History</a></li>
                        <li><a href="<%= ResolveUrl("~/NGO/Profile.aspx") %>">&#127970; Organization Profile</a></li>
                        <li><a href="<%= ResolveUrl("~/Account/Logout.aspx") %>">&#128682; Logout</a></li>
                    </ul>
                </asp:Panel>

                <!-- Volunteer Menu -->
                <asp:Panel ID="pnlVolunteerMenu" runat="server" Visible="false">
                    <ul class="sidebar-menu">
                        <li><a href="<%= ResolveUrl("~/Volunteer/Dashboard.aspx") %>">&#128202; Volunteer Dashboard</a></li>
                        <li><a href="<%= ResolveUrl("~/Volunteer/MyTasks.aspx") %>">&#128666; My Assigned Tasks</a></li>
                        <li><a href="<%= ResolveUrl("~/Volunteer/UpdateDelivery.aspx") %>">&#9989; Update Collection / Delivery</a></li>
                        <li><a href="<%= ResolveUrl("~/Volunteer/TaskDetails.aspx") %>">&#128100; Profile &amp; Activity History</a></li>
                        <li><a href="<%= ResolveUrl("~/Account/Logout.aspx") %>">&#128682; Logout</a></li>
                    </ul>
                </asp:Panel>
            </asp:Panel>

            <div id="divMainContentArea" runat="server">
                <asp:ContentPlaceHolder ID="MainContent" runat="server" />
            </div>
        </div>

        <!-- Footer -->
        <footer class="site-footer no-print">
            <div class="container">
                <div class="footer-grid">
                    <div>
                        <div class="brand-logo" style="color: #FFFFFF; margin-bottom: 12px;">
                            <span class="logo-badge">FB</span>
                            <span>Food<span class="accent-text">Bridge</span></span>
                        </div>
                        <p style="font-size: 14px; color: #94A3B8; margin-bottom: 12px;">
                            FoodBridge – Food Rescue and Donation Management System connects surplus food donors with verified NGOs and dedicated volunteers to eliminate hunger and reduce food waste.
                        </p>
                        <p style="color: #FDE68A; font-weight: 700; font-size: 14px;">"Save Food. Share Hope. Feed Lives."</p>
                    </div>
                    <div>
                        <h4 class="footer-title">Quick Links</h4>
                        <ul class="footer-links">
                            <li><a href="<%= ResolveUrl("~/Default.aspx") %>">Home</a></li>
                            <li><a href="<%= ResolveUrl("~/About.aspx") %>">About FoodBridge</a></li>
                            <li><a href="<%= ResolveUrl("~/HowItWorks.aspx") %>">How It Works</a></li>
                            <li><a href="<%= ResolveUrl("~/NGO/AvailableFood.aspx") %>">Available Food Listings</a></li>
                            <li><a href="<%= ResolveUrl("~/Contact.aspx") %>">Contact &amp; Feedback</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="footer-title">Join the Mission</h4>
                        <ul class="footer-links">
                            <li><a href="<%= ResolveUrl("~/Account/RegisterDonor.aspx") %>">Register as Food Donor</a></li>
                            <li><a href="<%= ResolveUrl("~/Account/RegisterNGO.aspx") %>">Register NGO / Shelter</a></li>
                            <li><a href="<%= ResolveUrl("~/Account/RegisterVolunteer.aspx") %>">Become a Rescue Volunteer</a></li>
                            <li><a href="<%= ResolveUrl("~/Account/Login.aspx") %>">Portal Login</a></li>
                        </ul>
                    </div>
                    <div>
                        <h4 class="footer-title">Central Coordination Office</h4>
                        <p style="font-size: 13.5px; color: #94A3B8; margin-bottom: 8px;">
                            #42 Green Tech Park, MG Road, Bengaluru - 560001, Karnataka, India
                        </p>
                        <p style="font-size: 13.5px; color: #94A3B8; margin-bottom: 8px;">
                            Email: support@foodbridge.com<br />
                            Helpline: +91 800-123-3663
                        </p>
                    </div>
                </div>
                <div class="footer-bottom">
                    &copy; <%= DateTime.Now.Year %> FoodBridge – Food Rescue and Donation Management System. Built with ASP.NET Web Forms &amp; VB.NET (.NET Framework 4.0). All Rights Reserved.
                </div>
            </div>
        </footer>

        <script type="text/javascript" src="<%= ResolveUrl("~/Content/js/site.js") %>"></script>
    </form>
</body>
</html>
